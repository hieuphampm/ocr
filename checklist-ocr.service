# Cài: sudo cp checklist-ocr.service /etc/systemd/system/ && sudo systemctl daemon-reload
#      sudo systemctl enable --now checklist-ocr
# Sửa User và đường dẫn cho đúng máy chủ. Xem log: journalctl -u checklist-ocr -f
[Unit]
Description=CHECKLIST HA OCR API
After=network.target

[Service]
User=ocr
WorkingDirectory=/opt/checklist-ocr
EnvironmentFile=/opt/checklist-ocr/.env
ExecStart=/opt/checklist-ocr/.venv/bin/python api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
