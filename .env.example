# Sao chép thành .env (cùng thư mục với ocr.py) rồi điền giá trị thật. KHÔNG commit/gửi file .env.
OPENAI_API_KEY=
# Model chạy trên chính server này thì trong Docker dùng host.docker.internal thay cho localhost
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
MODEL_NAME=

# --- API (python api.py) ---
PORT=33253
HOST=0.0.0.0
# Khóa truy cập: client phải gửi header  X-API-Key: <giá trị này>.  BỎ TRỐNG = ai biết địa chỉ cũng gọi được!
API_TOKEN=
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=10
# Số ảnh xử lý SONG SONG mỗi tiến trình (luồng). MAX_CONCURRENCY x WORKERS không nên vượt số nhân CPU của server.
MAX_CONCURRENCY=2
WORKERS=1
